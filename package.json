{
  "name": "animalese-voice-mix",
  "version": "1.0.0",
  "description": "轻量、低延迟、零第三方运行时依赖的中/日/英三语仿动森狸语实时语音合成与韵律控制算法（Web Audio 采样切片 + 共振峰双核引擎）。",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Claranceyy/animalese-voice-mix.git"
  },
  "homepage": "https://clarance.top/apps/animalese-voice-mix",
  "keywords": [
    "animalese",
    "animal-crossing",
    "web-audio",
    "prosody",
    "speech-synthesis",
    "formant-synthesis",
    "formant",
    "mandarin",
    "japanese",
    "typescript",
    "game-audio"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/animalese-voice-mix.js"
    }
  },
  "main": "./dist/animalese-voice-mix.js",
  "module": "./dist/animalese-voice-mix.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "speech",
    "src",
    "examples",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.1.1"
  }
}
